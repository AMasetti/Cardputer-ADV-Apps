#!/bin/sh
# Rechaza el push si algún commit a enviar atribuye autoría a una AI/agente.
hooks_dir=$(dirname "$0")
zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Borrado de rama remota: nada que revisar
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi

  for sha in $(git rev-list $range); do
    git log -1 --format=%B "$sha" | "$hooks_dir/check-ai-attribution.sh" "commit $(git rev-parse --short "$sha")" || status=1
  done
done

[ $status -ne 0 ] && echo "✖ Push cancelado. Reescribí esos commits (git rebase -i / --amend) y volvé a intentar." >&2
exit $status
